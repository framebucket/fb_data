# Copy to .env and set FB_SERVICE_TOKEN to a long random value.
FB_SERVICE_TOKEN=replace-with-a-long-random-secret
FB_DATA_ROOT=C:/Users/srini/OneDrive/Documents/FrameBucket/data_output
FB_PUBLIC_BASE_URL=http://127.0.0.1:8001
FB_MAX_UPLOAD_BYTES=1073741824
# Event QR selfie matching is opt-in at the guest form and enabled here by default.
FB_FACE_MATCHING_ENABLED=true
# Optional: use a persistent Railway volume to cache the OpenCV Zoo face models.
# FB_FACE_MODEL_DIR=/data/face-models
# Optional model URL overrides; defaults point to the OpenCV Zoo ONNX files.
# FB_FACE_DETECTOR_MODEL_URL=https://github.com/opencv/opencv_zoo/raw/refs/heads/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
# FB_FACE_RECOGNIZER_MODEL_URL=https://github.com/opencv/opencv_zoo/raw/refs/heads/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx
# FB_FACE_MATCH_THRESHOLD=0.42
# Storage backend: local (default), s3 (Railway Bucket or any S3-compatible bucket), google_drive
FB_STORAGE_BACKEND=local
# Optional temporary processing/download directory. On Railway, use writable ephemeral disk.
# FB_TEMP_ROOT=/tmp/framebucket-data

# S3-compatible storage (Railway Bucket credentials are in the Bucket's Connect/Variables panel)
# FB_S3_ENDPOINT_URL=https://<bucket-endpoint>
# FB_S3_BUCKET=<bucket-name>
# FB_S3_REGION=<bucket-region>
# FB_S3_ACCESS_KEY_ID=<access-key-id>
# FB_S3_SECRET_ACCESS_KEY=<secret-access-key>
# FB_S3_PREFIX=framebucket
# FB_S3_ADDRESSING_STYLE=virtual

# Google Drive storage (OAuth refresh token for a Google account with editor access to the folder)
# FB_GOOGLE_DRIVE_FOLDER_ID=<folder-id-or-https://drive.google.com/drive/folders/...>
# FB_GOOGLE_CLIENT_ID=<oauth-client-id>
# FB_GOOGLE_CLIENT_SECRET=<oauth-client-secret>
# FB_GOOGLE_REFRESH_TOKEN=<oauth-refresh-token>

# Optional: FB_LOGO_PATH=C:/path/to/transparent-logo.png
# Optional: FB_ENHANCER_MODEL=C:/path/to/enhancer.onnx
